server <- function(input, output, session) {
  rv <- reactiveValues(
    slots = lapply(1:5, function(floor) {
      list(motor = rep(FALSE, 10), mobil = rep(FALSE, 5))
    }),
    transactions = data.frame(
      tiket = character(), lantai = numeric(), jenis = character(),
      slot = numeric(), masuk = as.POSIXct(character()),
      keluar = as.POSIXct(character()), durasi = numeric(), biaya = numeric(),
      stringsAsFactors = FALSE
    ),
    tarif = list(motor = 5000, mobil = 15000),
    current_ticket = NULL
  )
  
  observeEvent(input$start_parking, {
    shinyjs::show("parking_interface")
  })
  output$capacity_overview <- renderUI({
    lapply(1:5, function(floor) {
      motor_available <- 10 - sum(rv$slots[[floor]]$motor)
      mobil_available <- 5 - sum(rv$slots[[floor]]$mobil)
      div(class = "floor-panel",
          h4(paste("Lantai", floor)),
          div(class = "progress-container",
              span("Motor: "),
              progressBar(paste0("motor_", floor), value = motor_available, total = 10,
                          status = "success", display_pct = TRUE)),
          div(class = "progress-container",
              span("Mobil: "),
              progressBar(paste0("mobil_", floor), value = mobil_available, total = 5,
                          status = "primary", display_pct = TRUE))
      )
    })
  })
  
  output$slot_buttons <- renderUI({
    req(input$lantai, input$jenis_kendaraan)
    floor <- as.numeric(input$lantai)
    jenis <- tolower(input$jenis_kendaraan)
    max_slot <- ifelse(jenis == "motor", 10, 5)
    fluidRow(
      lapply(1:max_slot, function(i) {
        status <- rv$slots[[floor]][[jenis]][i]
        btn_class <- ifelse(status, "btn-danger",
                            ifelse(jenis == "motor", "btn-success", "btn-primary"))
        actionButton(paste0("slot_", floor, "_", i), label = paste("Slot", i),
                     class = paste("btn", btn_class), disabled = status)
      })
    )
  })
  
  observe({
    lapply(1:5, function(floor) {
      lapply(1:10, function(i) {
        observeEvent(input[[paste0("slot_", floor, "_", i)]], {
          req(input$jenis_kendaraan)
          jenis <- tolower(input$jenis_kendaraan)
          max_slot <- ifelse(jenis == "motor", 10, 5)
          if (i <= max_slot) {
            id <- generate_ticket_id()
            rv$current_ticket <- list(
              id = id, lantai = floor, jenis = jenis, slot = i, waktu_masuk = Sys.time()
            )
            output$ticket_info <- renderText({
              paste("Tiket:", id, "\nLantai:", floor, "\nSlot:", i, "\nJenis:", input$jenis_kendaraan)
            })
            
            shinyjs::enable("confirm_parking")
          }
        })
      })
    })
  })
  
  observeEvent(input$confirm_parking, {
    req(rv$current_ticket)
    t <- rv$current_ticket
    rv$slots[[t$lantai]][[t$jenis]][t$slot] <- TRUE
    new_entry <- data.frame(
      tiket = t$id, lantai = t$lantai, jenis = input$jenis_kendaraan,
      slot = t$slot, masuk = t$waktu_masuk, keluar = as.POSIXct(NA),
      durasi = NA, biaya = NA
    )
    rv$transactions <- rbind(rv$transactions, new_entry)
    showNotification("Parkir berhasil dikonfirmasi!")
    shinyjs::reset("parking_interface")
  })
  
  observeEvent(input$process_exit, {
    req(input$exit_ticket)
    record <- which(rv$transactions$tiket == input$exit_ticket)
    if(length(record) == 0) {
      showNotification("Tiket tidak valid!", type = "error")
      return()
    }
    entry_time <- rv$transactions$masuk[record]
    exit_time <- Sys.time()
    durasi <- ceiling(as.numeric(difftime(exit_time, entry_time, units = "hours")))
    jenis <- tolower(rv$transactions$jenis[record])
    biaya <- durasi * rv$tarif[[jenis]]
    rv$transactions$keluar[record] <- exit_time
    rv$transactions$durasi[record] <- durasi
    rv$transactions$biaya[record] <- biaya
    rv$slots[[rv$transactions$lantai[record]]][[jenis]][rv$transactions$slot[record]] <- FALSE
    output$payment_details <- renderText({
      paste("Tiket:", input$exit_ticket,
            "\nDurasi:", durasi, "jam",
            "\nBiaya: Rp", formatC(biaya, format = "d", big.mark = "."))
    })
    shinyjs::show("payment_panel")
  })
  
  output$ewallet_qr <- renderUI({
    req(input$ewallet_option)
    qr_url <- switch(input$ewallet_option,
                     "QRIS M-Banking" = "https://api.qrserver.com/v1/create-qr-code/?data=QRIS-123456&size=200x200",
                     "GoPay" = "https://i.postimg.cc/zXGVbdBx/Screenshot-2025-05-21-081134.png",
                     "OVO" = "https://api.qrserver.com/v1/create-qr-code/?data=OVO-123456&size=200x200",
                     "ShopeePay" = "https://api.qrserver.com/v1/create-qr-code/?data=SHOPEEPAY-555555&size=200x200"
    )
    tags$img(src = qr_url, width = "200px", height = "200px")
  })
  
  output$revenue_chart <- renderPlotly({
    req(nrow(rv$transactions) > 0)
    df <- rv$transactions %>%
      filter(!is.na(biaya)) %>%
      mutate(tanggal = as.Date(masuk)) %>%
      group_by(tanggal) %>%
      summarise(pendapatan = sum(biaya))
    plot_ly(df, x = ~tanggal, y = ~pendapatan, type = 'bar') %>%
      layout(title = "Laporan Harian",
             xaxis = list(title = "Tanggal"),
             yaxis = list(title = "Pendapatan (Rp)"))
  })
  
  output$transaction_log <- renderDT({
    datatable(
      rv$transactions,
      options = list(scrollX = TRUE, pageLength = 5),
      rownames = FALSE,
      colnames = c('Tiket', 'Lantai', 'Jenis', 'Slot', 'Masuk', 'Keluar', 'Durasi', 'Biaya')
    ) %>%
      formatCurrency('biaya', 'Rp', digits = 0) %>%
      formatDate(c('masuk', 'keluar'), method = 'toLocaleString')
  })
  
  observeEvent(input$save_rates, {
    rv$tarif$motor <- input$tarif_motor
    rv$tarif$mobil <- input$tarif_mobil
    showNotification("Tarif berhasil diperbarui!")
  })
  observeEvent(input$confirm_payment, {
    # Tampilkan notifikasi selesai
    showNotification("Pembayaran berhasil. Terima kasih telah menggunakan layanan kami!", type = "message")
    
    # Reset input tiket keluar dan pembayaran
    updateTextInput(session, "exit_ticket", value = "")
    shinyjs::hide("payment_panel")
    
    # Kembali ke tab "Beranda"
    updateNavbarPage(session, inputId = "navbar", selected = "Beranda")
  })
  
}

shinyApp(ui, server)


